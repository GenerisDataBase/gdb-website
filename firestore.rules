rules_version = '2';

// ============================================================================
// Generis Data Base — Firestore security rules
//
// Deploy with:  firebase deploy --only firestore:rules
//
// Model
//   messages/{id}: server-created contacts, readable only by the verified admin.
//   Required: name, email, subject, body, createdAt, handled.
//   Optional server delivery metadata: emailNotifiedAt, emailDeliveryId and emailDeliveryState.
//   Clients may only toggle handled.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // The Google account allowed to open /admin.html and read contact messages.
    function adminEmail() { return 'generisdatabase@gmail.com'; }

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == adminEmail()
          && request.auth.token.email_verified == true;
    }

    // ----------------------------------------------------------------- messages
    function validMessage(d) {
      return d.keys().hasAll(['name','email','subject','body','createdAt','handled'])
          && d.keys().hasOnly(['name','email','subject','body','createdAt','handled','emailNotifiedAt','emailDeliveryId','emailDeliveryState'])
          && d.name is string    && d.name.size() >= 2  && d.name.size() <= 80
          && d.email is string   && d.email.size() >= 5 && d.email.size() <= 120
          && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
          && d.subject is string && d.subject.size() > 0 && d.subject.size() <= 60
          && d.body is string    && d.body.size() >= 10 && d.body.size() <= 4000
          && d.createdAt is timestamp
          && d.handled is bool
          && (!('emailNotifiedAt' in d) || d.emailNotifiedAt is timestamp)
          && (!('emailDeliveryId' in d) || (
            d.emailDeliveryId is string && d.emailDeliveryId.size() <= 256
          ))
          && (!('emailDeliveryState' in d) || d.emailDeliveryState in [
            'resend_inflight', 'smtp_ready', 'smtp_inflight', 'needs_review', 'sent'
          ]);
    }

    match /messages/{mid} {
      // The rate-limited contact Edge Function uses the Admin SDK/IAM path.
      // Public SDK writes would bypass its honeypot and IP rate limit.
      allow create: if false;
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && validMessage(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handled']);
    }

    // Everything not matched above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
