rules_version = '2';

// ============================================================================
// Generis Data Base — Firestore security rules
//
// Deploy with:  firebase deploy --only firestore:rules
//
// Model
//   messages/{id}  write-only for visitors, readable only by the owner
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // The Google account allowed to open /admin.html and read contact messages.
    function adminEmail() { return 'generisdatabase@gmail.com'; }

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == adminEmail()
          && request.auth.token.email_verified == true;
    }

    // ----------------------------------------------------------------- messages
    function validMessage(d) {
      return d.keys().hasOnly(['name','email','subject','body','createdAt','handled'])
          && d.name is string    && d.name.size() >= 2  && d.name.size() <= 80
          && d.email is string   && d.email.size() >= 5 && d.email.size() <= 120
          && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
          && d.subject is string && d.subject.size() > 0 && d.subject.size() <= 60
          && d.body is string    && d.body.size() >= 10 && d.body.size() <= 4000
          && d.createdAt == request.time
          && d.handled == false;
    }

    match /messages/{mid} {
      allow create: if validMessage(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Everything not matched above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
